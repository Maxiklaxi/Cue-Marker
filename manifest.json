{
  "manifestVersion": 5,
  "id": "de.meesfilm.cue-marker",
  "name": "Cue Marker",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "cueMarkerPanel",
      "label": {
        "default": "Cue Marker"
      },
      "minimumSize": {
        "width": 300,
        "height": 360
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 400,
        "height": 640
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite",
    "network": {
      "domains": [
        "api.github.com"
      ],
      "reasonForPermission": "Check GitHub for new Cue Marker releases"
    },
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": []
    }
  }
}
